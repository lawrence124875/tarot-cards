# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# ---- 塔羅 ----
# 平台資料夾由 CI 以 flutter create 產生
/android/
/ios/
# 解讀內容與牌面圖只在私人 repo；本公開 repo 只留 .gitkeep
/assets/content/**/*.json
/assets/decks/**/*.webp
/assets/decks/**/*.json
/assets/decks/*.json
/_content/
# 金鑰絕不 commit
*.jks
*.keystore
key.properties
# 字型子集由 CI 產生（scripts/build_fonts.py）
/assets/fonts/*.ttf
/_fonts_src/
# 介面翻譯由 ARB 自動產生（l10n.yaml）
/lib/l10n/app_localizations*.dart

# Firebase 設定檔由 CI 從 Secret 產生，不進 repo（HANDOFF §18）
google-services.json
GoogleService-Info.plist
# 商店截圖原始畫面含私人內容，不進公開 repo（screenshots/README.md）
/screenshots/out/

# App 圖示與牌背原圖只在私人 repo（tarot-content branding/），建置時由 import_content.sh 複製進來
/branding/
